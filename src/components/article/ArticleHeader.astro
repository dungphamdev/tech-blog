---
import type { BlogPost } from '../../utils/posts';
import { formatDate } from '../../utils/posts';
import { withBase } from '../../utils/paths';

interface Props {
  post: BlogPost;
  readingTime: string;
}

const { post, readingTime } = Astro.props;
---

<header class="max-w-[780px]">
  <p class="text-sm font-semibold uppercase tracking-wide" style="color: var(--accent)">
    {post.data.category ?? 'Article'}
  </p>
  <h1 class="mt-3 text-4xl font-bold leading-tight md:text-6xl">{post.data.title}</h1>
  <p class="mt-5 text-xl" style="color: var(--muted)">{post.data.description}</p>
  <div class="mt-5 flex flex-wrap gap-x-3 gap-y-2 text-sm" style="color: var(--muted)">
    <span>{formatDate(post.data.publishedAt)}</span>
    {post.data.updatedAt && <span>Updated {formatDate(post.data.updatedAt)}</span>}
    <span>{readingTime}</span>
    {post.data.draft && <span class="font-semibold" style="color: var(--accent)">Draft</span>}
  </div>
  <div class="mt-5 flex flex-wrap gap-2">
    {
      post.data.tags.map((tag) => (
        <a class="rounded-full border px-3 py-1 text-sm" style="border-color: var(--line)" href={withBase(`/tags/${tag}`)}>
          {tag}
        </a>
      ))
    }
  </div>
</header>
