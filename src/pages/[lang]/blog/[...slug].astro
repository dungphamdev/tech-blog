---
import { render } from 'astro:content';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import { getAllPosts, getAlternateUrls, getTranslation, localizedBlogPath, postSlug, postUrl } from '../../../utils/posts';
import { alternateLanguage } from '../../../utils/i18n';
import { getReadingTime } from '../../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body ?? '');
const alternateUrls = await getAlternateUrls(post);
const nextLang = alternateLanguage(post.data.lang);
const nextPost = await getTranslation(post, nextLang);
const languageSwitchUrl = nextPost ? postUrl(nextPost) : localizedBlogPath(nextLang);
---

<BlogPostLayout
  post={post}
  headings={headings}
  readingTime={readingTime}
  canonical={postUrl(post)}
  alternateUrls={alternateUrls}
  languageSwitchUrl={languageSwitchUrl}
>
  <Content />
</BlogPostLayout>
