---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/article/PostCard.astro';
import { getAllCategories, getAllPosts } from '../../../utils/posts';
import { LANGUAGES, localizedPath, type Language } from '../../../utils/i18n';

export async function getStaticPaths() {
  const paths = [];

  for (const lang of LANGUAGES) {
    const posts = await getAllPosts(lang);
    paths.push(
      ...getAllCategories(posts).map((category) => ({
        params: { lang, category },
        props: { posts: posts.filter((post) => post.data.category === category), category, lang },
      })),
    );
  }

  return paths;
}

const { posts, category, lang } = Astro.props as { posts: Awaited<ReturnType<typeof getAllPosts>>; category: string; lang: Language };
const alternateUrls = Object.fromEntries(LANGUAGES.map((language) => [language, localizedPath(language, `/categories/${category}`)]));
---

<BaseLayout
  title={category}
  description={`Articles in the ${category} category.`}
  lang={lang}
  canonical={localizedPath(lang, `/categories/${category}`)}
  alternateUrls={alternateUrls}
  languageSwitchUrl={localizedPath(lang === 'en' ? 'vi' : 'en', `/categories/${category}`)}
>
  <section class="container py-14">
    <h1 class="text-5xl font-bold">{category}</h1>
    <p class="mt-4" style="color: var(--muted)">{posts.length} article{posts.length === 1 ? '' : 's'}</p>
    <div class="mt-8">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
